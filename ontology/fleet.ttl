@prefix fro:  <https://fleet.example.com/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################################################
# Fleet Reliability Connectivity Pilot: maintenance & engineering ontology, version 1.0
#
# The shared business vocabulary for aircraft maintenance reliability: aircraft, defects, MEL
# deferrals, work orders, serialized components and their removals, parts, vendors, stations,
# airworthiness directives, and the flights maintenance delayed.
#
# This one file drives two physical models:
#   * the knowledge graph in Amazon Neptune (RDF, queried with SPARQL), and
#   * the lakehouse tables (Delta Lake), and their Unity Catalog definitions, generated by
#     fleet_kg/lakehouse.py: one table per class, one column per attribute, one foreign key
#     per single-valued relationship. Comments come from the definitions below.
#
# Constraints on valid records live in ../shapes/fleet-shapes.ttl (SHACL).
#################################################################################################

<https://fleet.example.com/ontology>
    a owl:Ontology ;
    rdfs:label "Fleet reliability ontology"@en ;
    dcterms:description "Shared business concepts and relationships for aircraft maintenance reliability."@en ;
    owl:versionInfo "1.0" .

#################################################################################################
# Classes
#################################################################################################

fro:BusinessEntity a owl:Class ; rdfs:label "Business entity"@en ;
    skos:definition "Anything maintenance & engineering keeps a record of and can identify by a business key."@en .

fro:Asset a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Asset"@en ;
    skos:definition "A physical, tracked item: an aircraft or a serialized component."@en .

fro:MaintenanceRecord a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Maintenance record"@en ;
    skos:definition "A record created by maintenance activity: a defect, deferral, work order or removal."@en .

fro:Organization a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Organization"@en .

fro:Aircraft a owl:Class ; rdfs:subClassOf fro:Asset ; rdfs:label "Aircraft"@en ;
    skos:altLabel "Tail"@en ;
    skos:definition "A single aircraft in the fleet, identified by its registration (tail number)."@en ;
    skos:example "N812BB" .

fro:Defect a owl:Class ; rdfs:subClassOf fro:MaintenanceRecord ; rdfs:label "Defect"@en ;
    skos:altLabel "Write-up"@en, "Discrepancy"@en ;
    skos:definition "A reported fault on an aircraft: a pilot report (PIREP) or a maintenance finding."@en ;
    skos:example "DF-100245" .

fro:Deferral a owl:Class ; rdfs:subClassOf fro:MaintenanceRecord ; rdfs:label "MEL deferral"@en ;
    skos:definition "Permission to fly with a defect unrepaired under a Minimum Equipment List item, until an expiry date set by the item's category."@en .

fro:WorkOrder a owl:Class ; rdfs:subClassOf fro:MaintenanceRecord ; rdfs:label "Work order"@en ;
    skos:altLabel "Task card"@en ;
    skos:definition "Maintenance work performed on an aircraft at a station: correcting a defect or accomplishing a directive."@en .

fro:ComponentRemoval a owl:Class ; rdfs:subClassOf fro:MaintenanceRecord ; rdfs:label "Component removal"@en ;
    skos:definition "The removal of a serialized component from an aircraft during a work order, with the hours it flew since installation and what the repair shop found."@en .

fro:ComponentUnit a owl:Class ; rdfs:subClassOf fro:Asset ; rdfs:label "Component"@en ;
    skos:altLabel "Serialized unit"@en, "Rotable"@en ;
    skos:definition "One physical, serial-numbered instance of a part. It moves between aircraft and repair shops over its life."@en .

fro:Part a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Part"@en ;
    skos:definition "A part number: the design of a component, with its ATA chapter and manufacturer."@en .

fro:Vendor a owl:Class ; rdfs:subClassOf fro:Organization ; rdfs:label "Vendor"@en ;
    skos:definition "A component manufacturer (OEM) or a repair station that overhauls components."@en .

fro:Station a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Station"@en ;
    skos:definition "An airport where the airline performs line maintenance; some are maintenance bases."@en .

fro:FlightLeg a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Flight leg"@en ;
    skos:definition "One scheduled flight on one date. In this pilot, only flights delayed or cancelled by a maintenance defect are recorded."@en .

fro:AirworthinessDirective a owl:Class ; rdfs:subClassOf fro:BusinessEntity ; rdfs:label "Airworthiness directive"@en ;
    skos:altLabel "AD"@en ;
    skos:definition "A mandatory action required by the regulator on the aircraft models it applies to, by a compliance date."@en .

fro:AtaChapter a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "ATA chapter"@en ;
    skos:definition "A node in the ATA iSpec 2200 aircraft system numbering, for example 36 Pneumatic within Airframe Systems."@en .

fro:DefectStatus a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Defect status"@en .

#################################################################################################
# Relationships. Inverse pairs are declared with owl:inverseOf; the load pipeline materializes
# them (fleet_kg/rules.py) because Neptune stores RDF but does not run an OWL reasoner.
#################################################################################################

# --- defects --------------------------------------------------------------------------------
fro:defectOn a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "defect on"@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:Aircraft ; owl:inverseOf fro:hasDefect .
fro:hasDefect a owl:ObjectProperty ; rdfs:label "has defect"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:Defect .

fro:reportedAt a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "reported at"@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:Station ; owl:inverseOf fro:stationDefect .
fro:stationDefect a owl:ObjectProperty ; rdfs:label "defect reported here"@en ;
    rdfs:domain fro:Station ; rdfs:range fro:Defect .

fro:inAtaChapter a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "in ATA chapter"@en ;
    rdfs:domain fro:BusinessEntity ; rdfs:range fro:AtaChapter .

fro:hasStatus a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "has status"@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:DefectStatus .

# --- deferrals ------------------------------------------------------------------------------
fro:defers a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "defers"@en ;
    rdfs:domain fro:Deferral ; rdfs:range fro:Defect ; owl:inverseOf fro:deferredBy .
fro:deferredBy a owl:ObjectProperty ; rdfs:label "deferred by"@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:Deferral .

fro:deferralOn a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "deferral on"@en ;
    rdfs:domain fro:Deferral ; rdfs:range fro:Aircraft ; owl:inverseOf fro:hasDeferral .
fro:hasDeferral a owl:ObjectProperty ; rdfs:label "has deferral"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:Deferral .

# --- work orders ----------------------------------------------------------------------------
fro:corrects a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "corrects"@en ;
    rdfs:domain fro:WorkOrder ; rdfs:range fro:Defect ; owl:inverseOf fro:correctedBy .
fro:correctedBy a owl:ObjectProperty ; rdfs:label "corrected by"@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:WorkOrder .

fro:workOrderOn a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "work order on"@en ;
    rdfs:domain fro:WorkOrder ; rdfs:range fro:Aircraft ; owl:inverseOf fro:hasWorkOrder .
fro:hasWorkOrder a owl:ObjectProperty ; rdfs:label "has work order"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:WorkOrder .

fro:performedAt a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "performed at"@en ;
    rdfs:domain fro:WorkOrder ; rdfs:range fro:Station ; owl:inverseOf fro:stationWorkOrder .
fro:stationWorkOrder a owl:ObjectProperty ; rdfs:label "work order performed here"@en ;
    rdfs:domain fro:Station ; rdfs:range fro:WorkOrder .

fro:accomplishes a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "accomplishes"@en ;
    rdfs:domain fro:WorkOrder ; rdfs:range fro:AirworthinessDirective ; owl:inverseOf fro:accomplishedBy .
fro:accomplishedBy a owl:ObjectProperty ; rdfs:label "accomplished by"@en ;
    rdfs:domain fro:AirworthinessDirective ; rdfs:range fro:WorkOrder .

# --- components -----------------------------------------------------------------------------
fro:removedUnit a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "removed unit"@en ;
    rdfs:domain fro:ComponentRemoval ; rdfs:range fro:ComponentUnit ; owl:inverseOf fro:hasRemoval .
fro:hasRemoval a owl:ObjectProperty ; rdfs:label "has removal"@en ;
    rdfs:domain fro:ComponentUnit ; rdfs:range fro:ComponentRemoval .

fro:removedFrom a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "removed from"@en ;
    rdfs:domain fro:ComponentRemoval ; rdfs:range fro:Aircraft ; owl:inverseOf fro:hadRemoval .
fro:hadRemoval a owl:ObjectProperty ; rdfs:label "had removal"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:ComponentRemoval .

fro:duringWorkOrder a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "during work order"@en ;
    rdfs:domain fro:ComponentRemoval ; rdfs:range fro:WorkOrder ; owl:inverseOf fro:includesRemoval .
fro:includesRemoval a owl:ObjectProperty ; rdfs:label "includes removal"@en ;
    rdfs:domain fro:WorkOrder ; rdfs:range fro:ComponentRemoval .

fro:afterRepairBy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "after repair by"@en ;
    skos:definition "The shop that last repaired the unit before the installation that ended in this removal. The basis for repair-shop reliability."@en ;
    rdfs:domain fro:ComponentRemoval ; rdfs:range fro:Vendor .

fro:ofPart a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "of part"@en ;
    rdfs:domain fro:ComponentUnit ; rdfs:range fro:Part ; owl:inverseOf fro:hasUnit .
fro:hasUnit a owl:ObjectProperty ; rdfs:label "has unit"@en ;
    rdfs:domain fro:Part ; rdfs:range fro:ComponentUnit .

fro:lastRepairedBy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "last repaired by"@en ;
    rdfs:domain fro:ComponentUnit ; rdfs:range fro:Vendor ; owl:inverseOf fro:repaired .
fro:repaired a owl:ObjectProperty ; rdfs:label "repaired"@en ;
    rdfs:domain fro:Vendor ; rdfs:range fro:ComponentUnit .

fro:installedOn a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "installed on"@en ;
    skos:definition "Where the unit is installed now. Units in a shop or in stores have none."@en ;
    rdfs:domain fro:ComponentUnit ; rdfs:range fro:Aircraft ; owl:inverseOf fro:hasInstalledUnit .
fro:hasInstalledUnit a owl:ObjectProperty ; rdfs:label "has installed unit"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:ComponentUnit .

fro:manufacturedBy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "manufactured by"@en ;
    rdfs:domain fro:Part ; rdfs:range fro:Vendor ; owl:inverseOf fro:manufactures .
fro:manufactures a owl:ObjectProperty ; rdfs:label "manufactures"@en ;
    rdfs:domain fro:Vendor ; rdfs:range fro:Part .

# --- aircraft, flights ------------------------------------------------------------------------
fro:homeBase a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "home base"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:Station .

fro:operatedBy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "operated by"@en ;
    rdfs:domain fro:FlightLeg ; rdfs:range fro:Aircraft ; owl:inverseOf fro:operated .
fro:operated a owl:ObjectProperty ; rdfs:label "operated"@en ;
    rdfs:domain fro:Aircraft ; rdfs:range fro:FlightLeg .

fro:departedFrom a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "departs from"@en ;
    rdfs:domain fro:FlightLeg ; rdfs:range fro:Station .

fro:delayedBy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "delayed by"@en ;
    rdfs:domain fro:FlightLeg ; rdfs:range fro:Defect ; owl:inverseOf fro:causedDelay .
fro:causedDelay a owl:ObjectProperty ; rdfs:label "caused delay"@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:FlightLeg .

# --- derived (written only by the materialization rules) -------------------------------------
fro:inSystemGroup a owl:ObjectProperty ; rdfs:label "in system group"@en ;
    skos:definition "Derived: the top-level ATA system group (Airframe Systems, Structures, Power Plant) of a defect's chapter."@en ;
    rdfs:domain fro:Defect ; rdfs:range fro:AtaChapter .

#################################################################################################
# Attributes
#################################################################################################

fro:identifier a owl:DatatypeProperty ; rdfs:label "identifier"@en ; rdfs:range xsd:string ;
    skos:definition "Any business key. Materialized from its sub-properties."@en .

fro:tailNumber       a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "tail number"@en ;       rdfs:domain fro:Aircraft ; rdfs:range xsd:string .
fro:defectNumber     a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "defect number"@en ;     rdfs:domain fro:Defect ; rdfs:range xsd:string .
fro:deferralNumber   a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "deferral number"@en ;   rdfs:domain fro:Deferral ; rdfs:range xsd:string .
fro:workOrderNumber  a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "work order number"@en ; rdfs:domain fro:WorkOrder ; rdfs:range xsd:string .
fro:removalNumber    a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "removal number"@en ;    rdfs:domain fro:ComponentRemoval ; rdfs:range xsd:string .
fro:serialNumber     a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "serial number"@en ;     rdfs:domain fro:ComponentUnit ; rdfs:range xsd:string .
fro:partNumber       a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "part number"@en ;       rdfs:domain fro:Part ; rdfs:range xsd:string .
fro:vendorCode       a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "vendor code"@en ;       rdfs:domain fro:Vendor ; rdfs:range xsd:string .
fro:stationCode      a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "station code"@en ;      rdfs:domain fro:Station ; rdfs:range xsd:string .
fro:flightLegId      a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "flight leg ID"@en ;     rdfs:domain fro:FlightLeg ; rdfs:range xsd:string .
fro:adNumber         a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier ; rdfs:label "AD number"@en ;         rdfs:domain fro:AirworthinessDirective ; rdfs:range xsd:string .
fro:ataCode          a owl:DatatypeProperty ; rdfs:subPropertyOf fro:identifier, skos:notation ; rdfs:label "ATA code"@en ; rdfs:domain fro:AtaChapter ; rdfs:range xsd:string .

# Aircraft
fro:aircraftModel  a owl:DatatypeProperty ; rdfs:label "aircraft model"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:string .
fro:msn            a owl:DatatypeProperty ; rdfs:label "manufacturer serial number"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:string .
fro:engineType     a owl:DatatypeProperty ; rdfs:label "engine type"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:string .
fro:deliveryDate   a owl:DatatypeProperty ; rdfs:label "delivery date"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:date .
fro:flightHours    a owl:DatatypeProperty ; rdfs:label "total flight hours"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:decimal .
fro:flightCycles   a owl:DatatypeProperty ; rdfs:label "total flight cycles"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:integer ;
    skos:definition "Takeoff-and-landing cycles since delivery."@en .
fro:cyclesInPeriod a owl:DatatypeProperty ; rdfs:label "flight cycles in period"@en ; rdfs:domain fro:Aircraft ; rdfs:range xsd:integer ;
    skos:definition "Departures flown in the reporting period (2025-10-01 to 2026-09-30); the denominator for defect rates."@en .

# Defect
fro:reportedDate      a owl:DatatypeProperty ; rdfs:label "reported date"@en ; rdfs:domain fro:Defect ; rdfs:range xsd:date .
fro:reportedDayNumber a owl:DatatypeProperty ; rdfs:label "reported day number"@en ; rdfs:domain fro:Defect ; rdfs:range xsd:integer ;
    skos:definition "Days since 2020-01-01. Derived during transformation so interval rules (repeat within N days) are simple comparisons."@en .
fro:reportSource      a owl:DatatypeProperty ; rdfs:label "report source"@en ; rdfs:domain fro:Defect ; rdfs:range xsd:string ;
    skos:definition "Pilot report (PIREP) or Maintenance finding (MAREP)."@en .
fro:description       a owl:DatatypeProperty ; rdfs:label "description"@en ; rdfs:domain fro:BusinessEntity ; rdfs:range xsd:string .

# Deferral
fro:melItem       a owl:DatatypeProperty ; rdfs:label "MEL item"@en ; rdfs:domain fro:Deferral ; rdfs:range xsd:string .
fro:melCategory   a owl:DatatypeProperty ; rdfs:label "MEL category"@en ; rdfs:domain fro:Deferral ; rdfs:range xsd:string ;
    skos:definition "Repair interval category: B (3 calendar days) or C (10 calendar days) in this pilot."@en .
fro:deferredDate  a owl:DatatypeProperty ; rdfs:label "deferred date"@en ; rdfs:domain fro:Deferral ; rdfs:range xsd:date .
fro:expiryDate    a owl:DatatypeProperty ; rdfs:label "expiry date"@en ; rdfs:domain fro:Deferral ; rdfs:range xsd:date .
fro:clearedDate   a owl:DatatypeProperty ; rdfs:label "cleared date"@en ; rdfs:domain fro:Deferral ; rdfs:range xsd:date .

# Work order
fro:openDate    a owl:DatatypeProperty ; rdfs:label "open date"@en ; rdfs:domain fro:WorkOrder ; rdfs:range xsd:date .
fro:closeDate   a owl:DatatypeProperty ; rdfs:label "close date"@en ; rdfs:domain fro:WorkOrder ; rdfs:range xsd:date .
fro:closeDayNumber a owl:DatatypeProperty ; rdfs:label "close day number"@en ; rdfs:domain fro:WorkOrder ; rdfs:range xsd:integer ;
    skos:definition "Days since 2020-01-01 of the close date. Derived during transformation."@en .
fro:action      a owl:DatatypeProperty ; rdfs:label "corrective action"@en ; rdfs:domain fro:WorkOrder ; rdfs:range xsd:string .
fro:laborHours  a owl:DatatypeProperty ; rdfs:label "labor hours"@en ; rdfs:domain fro:WorkOrder ; rdfs:range xsd:decimal .

# Removal
fro:removalDate       a owl:DatatypeProperty ; rdfs:label "removal date"@en ; rdfs:domain fro:ComponentRemoval ; rdfs:range xsd:date .
fro:unscheduled       a owl:DatatypeProperty ; rdfs:label "unscheduled"@en ; rdfs:domain fro:ComponentRemoval ; rdfs:range xsd:boolean .
fro:hoursSinceInstall a owl:DatatypeProperty ; rdfs:label "hours since install"@en ; rdfs:domain fro:ComponentRemoval ; rdfs:range xsd:decimal ;
    skos:definition "Flight hours the unit flew between installation and this removal (time since installation, TSI)."@en .
fro:shopFinding       a owl:DatatypeProperty ; rdfs:label "shop finding"@en ; rdfs:domain fro:ComponentRemoval ; rdfs:range xsd:string ;
    skos:definition "Confirmed failure, or No fault found (NFF): the shop could not reproduce the fault."@en .
fro:removalReason     a owl:DatatypeProperty ; rdfs:label "removal reason"@en ; rdfs:domain fro:ComponentRemoval ; rdfs:range xsd:string .

# Component, part, vendor, station
fro:lastShopVisitDate a owl:DatatypeProperty ; rdfs:label "last shop visit date"@en ; rdfs:domain fro:ComponentUnit ; rdfs:range xsd:date .
fro:unitCost          a owl:DatatypeProperty ; rdfs:label "unit cost (USD)"@en ; rdfs:domain fro:Part ; rdfs:range xsd:decimal .
fro:mtburTarget       a owl:DatatypeProperty ; rdfs:label "MTBUR target (hours)"@en ; rdfs:domain fro:Part ; rdfs:range xsd:integer ;
    skos:definition "Expected mean time between unscheduled removals in flight hours, from the reliability program."@en .
fro:vendorType        a owl:DatatypeProperty ; rdfs:label "vendor type"@en ; rdfs:domain fro:Vendor ; rdfs:range xsd:string .
fro:stationType       a owl:DatatypeProperty ; rdfs:label "station type"@en ; rdfs:domain fro:Station ; rdfs:range xsd:string .
fro:city              a owl:DatatypeProperty ; rdfs:label "city"@en ; rdfs:domain fro:BusinessEntity ; rdfs:range xsd:string .
fro:state             a owl:DatatypeProperty ; rdfs:label "state"@en ; rdfs:domain fro:Station ; rdfs:range xsd:string .
fro:country           a owl:DatatypeProperty ; rdfs:label "country"@en ; rdfs:domain fro:Vendor ; rdfs:range xsd:string .

# Flight leg
fro:flightNumber  a owl:DatatypeProperty ; rdfs:label "flight number"@en ; rdfs:domain fro:FlightLeg ; rdfs:range xsd:string .
fro:flightDate    a owl:DatatypeProperty ; rdfs:label "flight date"@en ; rdfs:domain fro:FlightLeg ; rdfs:range xsd:date .
fro:delayMinutes  a owl:DatatypeProperty ; rdfs:label "delay minutes"@en ; rdfs:domain fro:FlightLeg ; rdfs:range xsd:integer .
fro:cancelled     a owl:DatatypeProperty ; rdfs:label "cancelled"@en ; rdfs:domain fro:FlightLeg ; rdfs:range xsd:boolean .

# Airworthiness directive
fro:title           a owl:DatatypeProperty ; rdfs:label "title"@en ; rdfs:domain fro:AirworthinessDirective ; rdfs:range xsd:string .
fro:effectiveDate   a owl:DatatypeProperty ; rdfs:label "effective date"@en ; rdfs:domain fro:AirworthinessDirective ; rdfs:range xsd:date .
fro:complianceDate  a owl:DatatypeProperty ; rdfs:label "compliance date"@en ; rdfs:domain fro:AirworthinessDirective ; rdfs:range xsd:date .
fro:appliesToModel  a owl:DatatypeProperty ; rdfs:label "applies to model"@en ; rdfs:domain fro:AirworthinessDirective ; rdfs:range xsd:string ;
    skos:definition "An aircraft model the directive applies to (one value per model)."@en .
