# id: cq08
# title: Fix effectiveness by station
# question: For an ATA chapter, at which stations are fixes followed by the same chapter being written up again within 3 days?
# value: Points to stations that need troubleshooting support, tooling or training, instead of blaming the aircraft.
# param: ataCode | string | ^[0-9]{2}$ | 21
# param: withinDays | integer | ^[0-9]{1,2}$ | 3
PREFIX fro:  <https://fleet.example.com/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?stationCode (COUNT(?wo) AS ?fixes) (SUM(IF(?repeated, 1, 0)) AS ?repeatedWithinWindow)
       (ROUND(100 * SUM(IF(?repeated, 1, 0)) / COUNT(?wo)) AS ?repeatPct)
WHERE {
  ?wo fro:corrects ?d ; fro:performedAt/fro:stationCode ?stationCode ; fro:closeDayNumber ?n ;
      fro:workOrderOn ?a .
  ?d fro:inAtaChapter/fro:ataCode ?ataCode .
  VALUES ?ataCode { "21" }
  VALUES ?withinDays { 3 }
  BIND(EXISTS {
    ?d2 fro:defectOn ?a ; fro:inAtaChapter/fro:ataCode ?ataCode ; fro:reportedDayNumber ?n2 .
    FILTER(?d2 != ?d && ?n2 >= ?n && ?n2 - ?n <= ?withinDays)
  } AS ?repeated)
}
GROUP BY ?stationCode
HAVING (COUNT(?wo) >= 5)
ORDER BY DESC(?repeatPct)
